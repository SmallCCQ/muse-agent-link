{
  "description": "Muse Hub v2 DSH 薄适配插件：本地回环注册到独立 Muse Hub (:47617)，支持多 Muse 账号双向会话窗口、竞争审批与侧栏多账号管理。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "name": "@local/muse-agent-link",
  "type": "module",
  "version": "2.0.0"
}
